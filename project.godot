; Engine configuration file.
config_version=5

[application]

config/name="Hazard Hunt"
config/description="Occupational safety training game for skills trainees in Bangladesh."
config/version="0.1.2"
run/main_scene="res://game/splash.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.png"
config/quit_on_go_back=false

[autoload]

Loc="*res://core/localization.gd"
Progress="*res://core/progress_store.gd"
Sfx="*res://core/sound_player.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=4

[gui]

theme/custom="res://ui/theme/main_theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
